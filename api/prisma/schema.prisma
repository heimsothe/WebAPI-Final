// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// directUrl was removed: when prisma.config.ts is present, the Prisma
// CLI reads its migration URL from the config file's datasource.url
// (pointed at DIRECT_URL there). This block is read only by the Prisma
// Client at runtime, which uses the pooled DATABASE_URL.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            BigInt   @id @default(autoincrement())
  email         String   @unique
  password_hash String
  display_name  String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  oauth_credentials OauthCredential[]
  packages          Package[]
  exclusions        ExcludedTrackingNumber[]

  @@map("users")
}

model OauthCredential {
  id              BigInt    @id @default(autoincrement())
  user_id         BigInt
  provider        String
  access_token    String
  refresh_token   String
  expires_at      DateTime
  scope           String?
  connected_email String?
  last_sync_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, provider])
  @@map("oauth_credentials")
}

model Carrier {
  code         String   @id
  display_name String
  active       Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  packages   Package[]
  exclusions ExcludedTrackingNumber[]

  @@map("carriers")
}

model Package {
  id              BigInt    @id @default(autoincrement())
  user_id         BigInt
  carrier         String
  tracking_number String
  nickname        String?
  hidden          Boolean   @default(false)
  source          String
  source_email_id String?
  last_checked_at DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  carrier_ref     Carrier         @relation(fields: [carrier], references: [code])
  tracking_events TrackingEvent[]

  @@unique([user_id, tracking_number])
  @@map("packages")
}

model TrackingEvent {
  id                 BigInt   @id @default(autoincrement())
  package_id         BigInt
  event_time         DateTime
  status             String
  carrier_raw_status String?
  description        String?
  location           String?
  created_at         DateTime @default(now())

  package Package @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@unique([package_id, event_time, carrier_raw_status])
  @@index([package_id, event_time(sort: Desc)])
  @@map("tracking_events")
}

model ExcludedTrackingNumber {
  id              BigInt   @id @default(autoincrement())
  user_id         BigInt
  tracking_number String
  carrier         String?
  nickname        String?
  excluded_at     DateTime @default(now())

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  carrier_ref Carrier? @relation(fields: [carrier], references: [code])

  @@unique([user_id, tracking_number])
  @@map("excluded_tracking_numbers")
}
