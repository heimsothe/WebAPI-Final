{
    "info": {
        "name": "Package Tracker",
        "description": "Chained workflow demo for the deployed Package Tracker API. 18 requests across 4 folders. See api/postman/README.md for run instructions.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        { "key": "token", "value": "" },
        { "key": "connection_id", "value": "" },
        { "key": "package_id", "value": "" },
        { "key": "ups_package_id", "value": "" },
        { "key": "exclusion_id", "value": "" }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "POST /auth/signup",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "url": {
                            "raw": "{{host}}/auth/signup",
                            "host": ["{{host}}"],
                            "path": ["auth", "signup"]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\"email\":\"demo-{{$timestamp}}@example.com\",\"password\":\"Demo1234\",\"display_name\":\"Demo\"}"
                        }
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                                "const data = pm.response.json().data;",
                                "pm.collectionVariables.set('token', data.token);",
                                "pm.test('Returns token', () => pm.expect(data.token).to.be.a('string'));"
                            ]
                        }
                    }]
                },
                {
                    "name": "POST /auth/signin",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "url": {
                            "raw": "{{host}}/auth/signin",
                            "host": ["{{host}}"],
                            "path": ["auth", "signin"]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\"email\":\"demo@demo.com\",\"password\":\"Demo1234\"}"
                        }
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                "pm.test('Returns token', () => pm.expect(pm.response.json().data.token).to.be.a('string'));"
                            ]
                        }
                    }]
                },
                {
                    "name": "POST /auth/signin (wrong password)",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "url": {
                            "raw": "{{host}}/auth/signin",
                            "host": ["{{host}}"],
                            "path": ["auth", "signin"]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\"email\":\"demo@demo.com\",\"password\":\"wrong\"}"
                        }
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Status 401', () => pm.response.to.have.status(401));",
                                "pm.test('Code is INVALID_CREDENTIALS', () => pm.expect(pm.response.json().error.code).to.equal('INVALID_CREDENTIALS'));"
                            ]
                        }
                    }]
                }
            ]
        },
        {
            "name": "Gmail",
            "item": [
                {
                    "name": "GET /api/gmail/status",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "url": {
                            "raw": "{{host}}/api/gmail/status",
                            "host": ["{{host}}"],
                            "path": ["api", "gmail", "status"]
                        }
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                "const data = pm.response.json().data;",
                                "if (data.connections && data.connections.length > 0) {",
                                "    pm.collectionVariables.set('connection_id', data.connections[0].id);",
                                "}"
                            ]
                        }
                    }]
                },
                {
                    "name": "POST /api/gmail/connect",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "description": "Returns an auth URL. Open it in a browser, complete Google's consent flow, and return to this collection. The callback will redirect back to the frontend, which is fine for the demo.",
                        "url": {
                            "raw": "{{host}}/api/gmail/connect",
                            "host": ["{{host}}"],
                            "path": ["api", "gmail", "connect"]
                        }
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                "pm.test('Returns auth_url', () => pm.expect(pm.response.json().data.auth_url).to.be.a('string'));"
                            ]
                        }
                    }]
                },
                {
                    "name": "GET /api/gmail/status (after auth)",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "url": {
                            "raw": "{{host}}/api/gmail/status",
                            "host": ["{{host}}"],
                            "path": ["api", "gmail", "status"]
                        }
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                "const data = pm.response.json().data;",
                                "if (data.connections && data.connections.length > 0) {",
                                "    pm.collectionVariables.set('connection_id', data.connections[0].id);",
                                "}"
                            ]
                        }
                    }]
                },
                {
                    "name": "POST /api/gmail/sync",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "url": {
                            "raw": "{{host}}/api/gmail/sync",
                            "host": ["{{host}}"],
                            "path": ["api", "gmail", "sync"]
                        }
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Status 200', () => pm.response.to.have.status(200));"
                            ]
                        }
                    }]
                }
            ]
        },
        {
            "name": "Packages",
            "item": [
                {
                    "name": "GET /api/packages",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "url": {
                            "raw": "{{host}}/api/packages",
                            "host": ["{{host}}"],
                            "path": ["api", "packages"]
                        }
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                "pm.test('Returns array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                            ]
                        }
                    }]
                },
                {
                    "name": "POST /api/packages (FedEx)",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{token}}" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{host}}/api/packages",
                            "host": ["{{host}}"],
                            "path": ["api", "packages"]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\"tracking_number\":\"522005684672\",\"carrier\":\"FEDEX\"}"
                        }
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                                "const data = pm.response.json().data;",
                                "pm.collectionVariables.set('package_id', data.id);",
                                "pm.test('Has tracking_url', () => pm.expect(data.tracking_url).to.include('fedex.com'));",
                                "pm.test('Has events', () => pm.expect(data.events.length).to.be.greaterThan(0));"
                            ]
                        }
                    }]
                },
                {
                    "name": "POST /api/packages (UPS, tests 6.A)",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{token}}" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{host}}/api/packages",
                            "host": ["{{host}}"],
                            "path": ["api", "packages"]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\"tracking_number\":\"1ZR4115V0308717538\",\"carrier\":\"UPS\"}"
                        }
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Status 201 (6.A skips registry for UPS)', () => pm.response.to.have.status(201));",
                                "const data = pm.response.json().data;",
                                "pm.collectionVariables.set('ups_package_id', data.id);",
                                "pm.test('Stored as UPS', () => pm.expect(data.carrier).to.equal('UPS'));",
                                "pm.test('No events', () => pm.expect(data.events).to.have.lengthOf(0));",
                                "pm.test('last_checked_at is null', () => pm.expect(data.last_checked_at).to.equal(null));",
                                "pm.test('Has UPS tracking_url', () => pm.expect(data.tracking_url).to.include('ups.com'));"
                            ]
                        }
                    }]
                },
                {
                    "name": "GET /api/packages/{{package_id}}",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "url": {
                            "raw": "{{host}}/api/packages/{{package_id}}",
                            "host": ["{{host}}"],
                            "path": ["api", "packages", "{{package_id}}"]
                        }
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                "pm.test('Has events', () => pm.expect(pm.response.json().data.events).to.be.an('array'));"
                            ]
                        }
                    }]
                },
                {
                    "name": "PATCH /api/packages/{{package_id}}",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{token}}" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{host}}/api/packages/{{package_id}}",
                            "host": ["{{host}}"],
                            "path": ["api", "packages", "{{package_id}}"]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\"nickname\":\"Demo package\"}"
                        }
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                "pm.test('Nickname updated', () => pm.expect(pm.response.json().data.nickname).to.equal('Demo package'));"
                            ]
                        }
                    }]
                },
                {
                    "name": "POST /api/packages/{{package_id}}/refresh",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "description": "Likely returns 200 with skip_reason='rate_limited' because the cooldown is 5 minutes from the previous POST.",
                        "url": {
                            "raw": "{{host}}/api/packages/{{package_id}}/refresh",
                            "host": ["{{host}}"],
                            "path": ["api", "packages", "{{package_id}}", "refresh"]
                        }
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                "pm.test('Has refresh outcome', () => pm.expect(pm.response.json().data.refresh).to.be.an('object'));"
                            ]
                        }
                    }]
                },
                {
                    "name": "GET /api/packages?hidden=all",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "url": {
                            "raw": "{{host}}/api/packages?hidden=all",
                            "host": ["{{host}}"],
                            "path": ["api", "packages"],
                            "query": [{ "key": "hidden", "value": "all" }]
                        }
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Status 200', () => pm.response.to.have.status(200));"
                            ]
                        }
                    }]
                },
                {
                    "name": "DELETE /api/packages/{{ups_package_id}}",
                    "request": {
                        "method": "DELETE",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "url": {
                            "raw": "{{host}}/api/packages/{{ups_package_id}}",
                            "host": ["{{host}}"],
                            "path": ["api", "packages", "{{ups_package_id}}"]
                        }
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Status 204', () => pm.response.to.have.status(204));"
                            ]
                        }
                    }]
                }
            ]
        },
        {
            "name": "Exclusions",
            "item": [
                {
                    "name": "GET /api/exclusions",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "url": {
                            "raw": "{{host}}/api/exclusions",
                            "host": ["{{host}}"],
                            "path": ["api", "exclusions"]
                        }
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                "const data = pm.response.json().data;",
                                "pm.test('Has the just-deleted UPS exclusion', () => pm.expect(data.length).to.be.greaterThan(0));",
                                "pm.collectionVariables.set('exclusion_id', data[0].id);"
                            ]
                        }
                    }]
                },
                {
                    "name": "POST /api/packages (UPS, expect 409 EXCLUDED)",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{token}}" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{host}}/api/packages",
                            "host": ["{{host}}"],
                            "path": ["api", "packages"]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\"tracking_number\":\"1ZR4115V0308717538\",\"carrier\":\"UPS\"}"
                        }
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Status 409', () => pm.response.to.have.status(409));",
                                "pm.test('Code is EXCLUDED', () => pm.expect(pm.response.json().error.code).to.equal('EXCLUDED'));"
                            ]
                        }
                    }]
                },
                {
                    "name": "DELETE /api/exclusions/{{exclusion_id}}",
                    "request": {
                        "method": "DELETE",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "url": {
                            "raw": "{{host}}/api/exclusions/{{exclusion_id}}",
                            "host": ["{{host}}"],
                            "path": ["api", "exclusions", "{{exclusion_id}}"]
                        }
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Status 204', () => pm.response.to.have.status(204));"
                            ]
                        }
                    }]
                }
            ]
        }
    ]
}
