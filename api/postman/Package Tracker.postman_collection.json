    {
      "name": "[Gmail] POST /api/gmail/sync",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 or 409', () => pm.expect([200, 409]).to.include(pm.response.code));",
              "if (pm.response.code === 409) {",
              "    pm.test('Code is GMAIL_NOT_CONNECTED', () => pm.expect(pm.response.json().error.code).to.equal('GMAIL_NOT_CONNECTED'));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{host}}/api/gmail/sync",
          "host": [
            "{{host}}"
          ],
          "path": [
            "api",
            "gmail",
            "sync"
          ]
        },
        "description": "Returns 200 (with sync results) when the caller has a connected Gmail account, or 409 GMAIL_NOT_CONNECTED when they do not. The collection's signup-based auth means the running user is fresh and has no connection, so 409 is the typical outcome here."
      },
      "response": []
