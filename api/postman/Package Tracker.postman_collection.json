      "name": "[Gmail] POST /api/gmail/sync",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 or 409', () => pm.expect([200, 409]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "    pm.test('Has syncs array', () => pm.expect(pm.response.json().data.syncs).to.be.an('array'));",
              "} else {",
              "    pm.test('Code is GMAIL_NOT_CONNECTED', () => pm.expect(pm.response.json().error.code).to.equal('GMAIL_NOT_CONNECTED'));",
              "}"
            ]
          }
        }
      ],
